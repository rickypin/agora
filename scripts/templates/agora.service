# agora daemon 的 systemd 用户单元（scripts/install.sh 生成；docs/spec/config.md「安装」）。
# LANG=C.UTF-8 是 ADR-001 D7 的要求：pane 进程继承 tmux server 的环境，server 又继承
# daemon 的，daemon 起在 systemd 里就没有登录 shell 的 locale——devcenter 的 CJK 乱码就是这么来的。
# AGORA_HOME 与 PATH 两处占位符由安装脚本替换（模板见 scripts/templates/）。

[Unit]
Description=agora daemon (multi-agent dashboard)
After=network.target

[Service]
Type=simple
Environment=LANG=C.UTF-8
Environment=AGORA_HOME=@AGORA_HOME@
Environment=PATH=@PATH@
ExecStart=@AGORA_HOME@/bin/agora serve
# 只对 daemon 主进程发 SIGTERM。tmux server 由 daemon 起、daemonize 后仍在这个 cgroup 里，
# 默认的 KillMode=control-group 会在 stop / restart（含 agora upgrade）时把它连同全部 agent 一起杀——
# 2026-09-07 zuan 实测 reconcile missing=3、tmux -L agora ls 无 server（agora-x1z；不变量 3、A39）。
KillMode=process
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
